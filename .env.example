# Example environment for SmartStay (Vite). Copy the keys you need into
# .env.development / .env.qa / .env.production. Real values are not stored here.

VITE_API_URL=
VITE_V2_API_URL=

# Property Setup onboarding (src/Pages/OnboardingFile).
# "true"  -> signed-in owners without a property are sent to /onboarding
#            (4 steps, no sidebar) until they finish setup.
# unset / "false" (default) -> the app behaves exactly as before; /onboarding
#            does not exist.
VITE_ENABLE_ONBOARDING=false

# Design System v2 Settings (src/DesignSystem, src/Pages/Settings/V2).
# "true" -> Settings uses the new shell + My profile screen.
# unset / "false" (default) -> the current Settings screens, unchanged.
VITE_SETTINGS_V2=false
